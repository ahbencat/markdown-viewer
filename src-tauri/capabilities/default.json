{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MVP: file open dialog + read text files.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": ["$DOCUMENT/**/*", "$DESKTOP/**/*", "$DOWNLOAD/**/*", "$HOME/**/*"]
    }
  ]
}
